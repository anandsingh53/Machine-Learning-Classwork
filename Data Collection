#📊 Data Collection
#📌 Overview

Data Collection is the first and most important step in the Machine Learning pipeline. It involves gathering raw data from various sources, organizing it into a structured format, and preparing it for further processing such as cleaning, analysis, and model training.

In this project , different methods for data collection 
Structured data (CSV, Excel, SQL)
Web data (scraping,
APIs)

Streaming data (IoT / Sensors / Kafka)

Unstructured
data (Images, Text, Audio)

cloud storage data

Logs / System
data




Collect Data from CSV / Excel
CSV File
import pandas as pd

df = pd.read_csv("data.csv")
print(df.head())
Excel File
import pandas as pd

df = pd.read_excel("data.xlsx", sheet_name=0)
print(df.head())


2. Collect Data from SQL Databases
MySQL
import pandas as pd
import mysql.connector

conn = mysql.connector.connect(
    host="localhost",
    user="root",
    password="password",
    database="employees"
)

query = "SELECT * FROM emp_table"
df = pd.read_sql(query, conn)
print(df.head())
SQLite
import sqlite3
import pandas as pd

conn = sqlite3.connect("example.db")
df = pd.read_sql("SELECT * FROM students", conn)
print(df.head())
3. Collect Data using REST API
Example: JSON placeholder or any real API.

import requests
import pandas as pd

url = "https://jsonplaceholder.typicode.com/posts"
response = requests.get(url)
data = response.json()

df = pd.DataFrame(data)
print(df.head())


4. Web Scraping (BeautifulSoup)
import requests
from bs4 import BeautifulSoup

url = "https://example.com"
html = requests.get(url).text

soup = BeautifulSoup(html, "html.parser")
titles = soup.find_all("h1")

for t in titles:
    print(t.text)


5. Scraping Dynamic Websites Using
Selenium
from selenium import webdriver
from selenium.webdriver.common.by import By

driver = webdriver.Chrome()
driver.get("https://example.com")

elements = driver.find_elements(By.TAG_NAME, "h1")

for el in elements:
    print(el.text)

driver.quit()


6. Streaming Data Collection (Kafka)
from kafka import KafkaConsumer

consumer = KafkaConsumer(
    'sensor-topic',
    bootstrap_servers=['localhost:9092'],
    auto_offset_reset='earliest'
)

for message in consumer:
    print(message.value.decode())


 7. IoT / Sensor Data (MQTT)
import paho.mqtt.client as mqtt

def on_message(client, userdata, msg):
    print("Sensor Data:", msg.payload.decode())

client = mqtt.Client()
client.connect("mqtt.eclipseprojects.io", 1883)
client.subscribe("iot/sensor1")
client.on_message = on_message

client.loop_forever()


8. Image Data Collection (Folder Loading)
import cv2
import os

images = []
path = "images_folder/"

for file in os.listdir(path):
    img = cv2.imread(os.path.join(path, file))
    images.append(img)

print("Loaded", len(images), "images")


